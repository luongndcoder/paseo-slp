{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slp.local/schemas/report.frontmatter.schema.json",
  "title": "SLP report.md front-matter (Lead -> Supervisor)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "slices",
    "acceptance",
    "open_questions",
    "hard_gates_hit",
    "deferred_minor",
    "metrics"
  ],
  "properties": {
    "status": {
      "enum": [
        "done",
        "blocked",
        "needs_input"
      ]
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "rounds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fix",
              "block"
            ]
          },
          "rounds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "done"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard_gates_hit": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferred_minor": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "reviews"
      ],
      "description": "Per-role metrics (SLP-SPEC 7b). `reviews` is required; other keys are free-form: rounds_total, verify_failures, tokens, scope_challenges{raised,accepted,rejected}, ...",
      "properties": {
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_profile",
              "findings_total",
              "findings_accepted",
              "changed_outcome"
            ],
            "properties": {
              "reviewer_profile": {
                "type": "string",
                "minLength": 1,
                "description": "Paseo profile id of the reviewer, e.g. slp-checker-sonnet."
              },
              "slice": {
                "type": "string",
                "minLength": 1,
                "description": "Slice id, or `workstream`."
              },
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "findings_total": {
                "type": "integer",
                "minimum": 0,
                "description": "Findings in the raw review (kept + rejected by slp-evidence)."
              },
              "findings_accepted": {
                "type": "integer",
                "minimum": 0,
                "description": "Findings that survived slp-evidence and that the Lead acted on or deferred."
              },
              "changed_outcome": {
                "type": "boolean",
                "description": "True when at least one accepted finding led to a code change before the slice/workstream was accepted."
              }
            }
          }
        }
      }
    }
  }
}
