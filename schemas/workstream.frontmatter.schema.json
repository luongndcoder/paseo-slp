{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slp.local/schemas/workstream.frontmatter.schema.json",
  "title": "SLP workstream.md front-matter (Supervisor -> Lead)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal", "scope", "out_of_scope", "acceptance", "hard_gates_known", "budget", "base_branch"
  ],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hard_gates_known": {"type": "array", "items": {"type": "string"}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_slices", "max_rounds"],
      "properties": {
        "max_slices": {"type": "integer", "minimum": 1},
        "max_rounds": {"type": "integer", "minimum": 1}
      }
    },
    "base_branch": {"type": "string", "minLength": 1}
  }
}
