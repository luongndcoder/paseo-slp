{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slp.local/schemas/result.schema.json",
  "title": "SLP slice result (Builder -> Lead)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slice_id", "status", "files_changed", "tests", "deviations", "questions", "hard_gates",
    "summary"
  ],
  "properties": {
    "slice_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "status": {"enum": ["done", "blocked", "needs_input"]},
    "files_changed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "passed", "failed"],
      "properties": {
        "cmd": {"type": "string"},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "deviations": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "hard_gates": {"type": "array", "items": {"type": "string"}},
    "summary": {
      "type": "string",
      "description": "At most 5 lines.",
      "pattern": "^[^\\n]*(\\n[^\\n]*){0,4}\\n?$"
    }
  }
}
