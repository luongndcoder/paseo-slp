{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slp.local/schemas/brief.frontmatter.schema.json",
  "title": "SLP brief.md front-matter (Lead -> Builder)",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "goal", "files", "base_ref", "tests_must_pass", "out_of_scope"],
  "properties": {
    "slice_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "goal": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "base_ref": {"type": "string", "minLength": 1},
    "tests_must_pass": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "parallel_group": {"type": "string", "minLength": 1}
  }
}
