{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slp.local/schemas/brief.frontmatter.schema.json",
  "title": "SLP brief.md front-matter (Lead -> Builder)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slice_id",
    "goal",
    "constraints",
    "design_choice",
    "files",
    "base_ref",
    "tests_must_pass",
    "out_of_scope"
  ],
  "properties": {
    "slice_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Part 1: the outcome and why it matters. No implementation steps."
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Part 2, binding: hard gates, invariants (e.g. tenant isolation), rules the work must not break. Together with `files`, `tests_must_pass` and `out_of_scope` these are not negotiable."
    },
    "design_choice": {
      "type": "string",
      "minLength": 1,
      "description": "Part 3: the Lead's current proposed approach. Explicitly challengeable: the Builder may answer with result.json `scope_challenge`."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "tests_must_pass": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parallel_group": {
      "type": "string",
      "minLength": 1
    }
  }
}
