#!/usr/bin/env python3
"""slp-conformance: spawn one cheap probe agent per SLP provider and judge the harness.

Deterministic evidence (files on disk) wins over self-reports. Results go to
conformance/conformance-<YYYY-MM-DD-HHMM>.json and a table is printed.

  slp-conformance                    all roles
  slp-conformance --roles lead,pi-builder
  slp-conformance --cheap            every role on its cheap probe model (policy probe.model) instead of the profile model

EVERY role (all families) runs on the REAL model/mode/thinking of its daemon.agentProfiles entry in
~/.paseo/config.json (--profile-models, the default; `probe.profile` in policy.yaml maps role -> profile id(s)).
A role with several profiles gets one probe per profile (`claude-checker@slp-checker-opus`). A cheap-model run passes
falsely when a model-dependent override only bites on the real model (fast-mode on Opus, see README "Why
bin/slp-claude"). Use --thinking to cap the thinking effort of Claude profiles (cost).

All probes run in ONE fixed scratch dir (SCRATCH below, gitignored) so Paseo creates a single
workspace/project; probe files are named per variant. At the end the probe agents are archived
and the scratch project is removed through the daemon API (lib/paseo_remove_project.mjs).
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import copy
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path
from typing import Any

_VENV_PY = Path.home() / ".claude" / "skills" / ".venv" / "bin" / "python3"
if __name__ == "__main__" and _VENV_PY.is_file() and Path(sys.executable) != _VENV_PY:
    os.execv(str(_VENV_PY), [str(_VENV_PY), *sys.argv])

import yaml  # noqa: E402

